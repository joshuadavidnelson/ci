{
  "name": "joshuadavidnelson/ci-fixture-php-plugin",
  "description": "Fixture the ci repository's self-test runs php-plugin.yml against. Satisfies the repo contract in README.md.",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "autoload": {
    "psr-4": { "CiFixture\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "CiFixture\\Tests\\": "tests/" }
  },
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "php-parallel-lint/php-parallel-lint": "^1.4",
    "phpmd/phpmd": "^2.15",
    "phpmetrics/phpmetrics": "^2.8",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "config": {
    "platform": { "php": "8.2.0" },
    "sort-packages": true
  },
  "scripts": {
    "lint": "./vendor/bin/parallel-lint src/ tests/",
    "phpcs": "./vendor/bin/phpcs",
    "phpstan": "./vendor/bin/phpstan analyse --memory-limit=1G",
    "phpmd": "php -d error_reporting='E_ALL & ~E_DEPRECATED' ./vendor/bin/phpmd src/ text phpmd.xml",
    "phpunit": "@php ./vendor/bin/phpunit",
    "phpunit:coverage-clover": "@php -dxdebug.mode=coverage ./vendor/bin/phpunit --coverage-clover coverage/php-clover.xml",
    "phpmetrics-summary": "php -d error_reporting='E_ALL & ~E_DEPRECATED' ./vendor/bin/phpmetrics --composer=false --report-summary-json=reports/metrics-summary.json src/"
  }
}
